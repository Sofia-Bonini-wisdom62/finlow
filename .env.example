# ---------- banco ----------
DATABASE_URL=

# ---------- auth ----------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- criptografia dos dados financeiros ----------
# 32 bytes em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PERDER ESTA CHAVE = PERDER OS DADOS. Precisa ser idêntica na Vercel.
ENCRYPTION_KEY=

# ---------- Vertex AI ----------
GOOGLE_VERTEX_PROJECT=
# Os modelos Gemini 3.x só são servidos em `global` — us-central1 devolve 404.
GOOGLE_VERTEX_LOCATION=global

# Local: caminho do JSON da service account (arquivo fica fora do git)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/vertex-sa.json

# Produção (Vercel): a Vercel não tem filesystem persistente, então em vez do
# caminho vai o JSON INTEIRO da service account, numa linha só.
# GOOGLE_VERTEX_CREDENTIALS_JSON={"type":"service_account",...}

# Modelos verificados contra o projeto em 27/07/2026 (sondagem, não documentação).
# gemini-3-flash NÃO existe. Disponíveis: gemini-3.1-flash-lite, gemini-2.5-flash,
# gemini-2.5-flash-lite, gemini-2.5-pro.
GEMINI_MODEL_PARSING=gemini-3.1-flash-lite
GEMINI_MODEL_CHAT=gemini-3.1-flash-lite

# Modulo Avancado (persona C): beta fechado por e-mail, separado por virgula.
# Liga consolidacao de investimentos, projecao e pessoal x trabalho sem mexer no banco.
AVANCADO_BETA_EMAILS=

# ---------- app ----------
# URL publica do app. O checkout da Stripe usa como endereco de retorno:
# sem ela a rota /api/pagamento/checkout devolve 500 de proposito.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Stripe (pagamento) ----------
# Use sk_test_ em desenvolvimento. lib/pagamento/stripe.ts recusa chave live
# fora de producao. Antes de trocar para sk_live_, ler
# docs/pagamento-antes-de-cobrar.md.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Assinatura do webhook (whsec_...), painel da Stripe > Webhooks.
STRIPE_WEBHOOK_SECRET=

# ---------- observabilidade (opcional) ----------
# /api/ops/metrics le metricas do Cloud Monitoring. Sem estas duas a rota
# de ops falha, mas o resto do app nao depende delas.
# JSON inteiro da service account do GCP, numa linha so.
GCP_SA_KEY=
# Token que protege a rota; sem ele a rota fica aberta.
OPS_METRICS_TOKEN=

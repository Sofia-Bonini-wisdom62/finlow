# ---------- banco ----------
DATABASE_URL=

# ---------- auth ----------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- criptografia dos dados financeiros ----------
# 32 bytes em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PERDER ESTA CHAVE = PERDER OS DADOS. Precisa ser idêntica na Vercel.
ENCRYPTION_KEY=

# ---------- Vertex AI ----------
GOOGLE_VERTEX_PROJECT=
# Os modelos Gemini 3.x só são servidos em `global` — us-central1 devolve 404.
GOOGLE_VERTEX_LOCATION=global

# Local: caminho do JSON da service account (arquivo fica fora do git)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/vertex-sa.json

# Produção (Vercel): a Vercel não tem filesystem persistente, então em vez do
# caminho vai o JSON INTEIRO da service account, numa linha só.
# GOOGLE_VERTEX_CREDENTIALS_JSON={"type":"service_account",...}

# Modelos verificados contra o projeto em 27/07/2026 (sondagem, não documentação).
# gemini-3-flash NÃO existe. Disponíveis: gemini-3.1-flash-lite, gemini-2.5-flash,
# gemini-2.5-flash-lite, gemini-2.5-pro.
GEMINI_MODEL_PARSING=gemini-3.1-flash-lite
GEMINI_MODEL_CHAT=gemini-3.1-flash-lite

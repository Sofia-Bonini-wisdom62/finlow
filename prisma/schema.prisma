generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  nome          String?
  idade         Int?
  emailVerified DateTime?
  image         String?
  criadoEm     DateTime          @default(now())
  perfil        Perfil?
  progresso     ProgressoModulo[]
  accounts      Account[]
  sessions      Session[]
}

model Perfil {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  tipo      String
  respostas Json
  criadoEm DateTime @default(now())
}

model Modulo {
  id         String            @id @default(cuid())
  slug       String            @unique
  titulo     String
  subtitulo  String
  tipoPerfil String
  ordem      Int
  xp         Int               @default(50)
  telas      Tela[]
  progresso  ProgressoModulo[]

  @@index([tipoPerfil, ordem])
}

model Tela {
  id       String @id @default(cuid())
  moduloId String
  modulo   Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  ordem    Int
  tipo     String
  label    String
  conteudo Json

  @@unique([moduloId, ordem])
}

model ProgressoModulo {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduloId    String
  modulo      Modulo    @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  concluido   Boolean   @default(false)
  telaAtual   Int       @default(0)
  concluidoEm DateTime?
  criadoEm    DateTime  @default(now())

  @@unique([userId, moduloId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

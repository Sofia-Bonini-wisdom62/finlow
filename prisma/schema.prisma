generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(cuid())
  email                 String                @unique
  nome                  String?
  dataNascimento        DateTime? // só informativo — sem validação de idade (decisão da fundadora, 04/07/2026)
  senha                 String? // hash bcrypt — null para contas OAuth
  consentimentoLGPD     DateTime? // reservado de antes do pivô (era consentimento de responsável); público hoje é adulto — manter até a política de privacidade (R1) definir o destino
  consentimentoPainelEm DateTime? // opt-in específico do Painel (R8) — sem ele, nenhum write de Painel
  memoriaAtiva          Boolean               @default(false) // opt-in da memória do assistente — desligada até a pessoa ligar
  onboardingEm          DateTime? // quando terminou a primeira conversa; null = ainda não fez
  // --- SPEC v3 §3 ---
  nivel                 String                @default("iniciante") // inferido no processamento; depois só por sinal duro
  tendencia             String? // legado; a IA pode revisar observando o dash
  pontos                Int                   @default(0)
  apelido               String?               @unique // nome exibido no ranking
  rankingOptIn          Boolean               @default(false) // ranking é opt-in explícito
  codigoIndicacao       String?               @unique // 8 chars base36 do link /r/{codigo} — gerado sob demanda, nunca no cadastro
  moduloAvancado        Boolean               @default(false) // Módulo Avançado (persona C) — liga aqui ou via AVANCADO_BETA_EMAILS (lib/plano.ts)
  emailVerified         DateTime?
  image                 String?
  criadoEm              DateTime              @default(now())
  perfil                Perfil?
  progresso             ProgressoModulo[]
  progressoLicoes       ProgressoLicao[]
  extratoImports        ExtratoImport[]
  contasFixas           ContaFixa[]
  transacoes            Transacao[]
  categorias            Categoria[]
  memorias              MemoriaUsuario[]
  orcamentos            Orcamento[]
  onboarding            Onboarding?
  eventos               EventoPontuacao[]
  insights              Insight[]
  recomendacoes         RecomendacaoTrilha[]
  conversas             Conversa[]
  indicacoesFeitas      Indicacao[]           @relation("indicador")
  indicacaoRecebida     Indicacao?            @relation("indicado")
  diagnosticoVazamento  DiagnosticoVazamento?
  investimentos         Investimento[]
  accounts              Account[]
  sessions              Session[]
}

/// Consolidação de investimentos (Módulo Avançado, persona C). Entrada
/// MANUAL — Open Finance é outra frente e este repo não toca nisso.
///
/// `nome`, `instituicao` e `valorAtual` são CIFRADOS: passe por
/// lib/investimento-repo.ts, nunca por db.investimento direto (só deleteMany —
/// apagar não toca campo cifrado). `tipo` fica em claro de propósito, como
/// Transacao.tipo: o card agrupa por ele no banco e o tipo sozinho não revela
/// quanto nem onde.
model Investimento {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo         String // "renda_fixa" | "acoes" | "fundos" | "cripto" | "outro"
  nome         String // CIFRADO
  instituicao  String? // CIFRADO
  valorAtual   String // CIFRADO
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([userId])
}

/// Diagnóstico de Vazamento: quanto escapa por mês sem a pessoa ver —
/// assinaturas, cobranças em dobro, juros/tarifas e categoria fora da curva.
///
/// UMA linha por usuário (userId @unique), reescrita a cada geração: o
/// diagnóstico é uma FOTO dos números de agora, não um histórico. O que
/// precisa sobreviver às regerações mora em colunas próprias: `entregueEm`
/// (a entrega no chat acontece UMA vez) e `tokenPublico` (o link do card
/// compartilhável não pode trocar toda vez que a foto atualiza).
///
/// `totalAnual`, `achados` e `narrativa` são CIFRADOS (AES-256-GCM) — é
/// leitura direta dos valores financeiros, mesma regra de Transacao.
/// `tokenPublico` só existe se a pessoa PEDIU o link público (opt-in).
model DiagnosticoVazamento {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAnual   String // CIFRADO
  achados      String // CIFRADO — JSON dos achados
  narrativa    String? // CIFRADO — leitura da IA (opcional; tem fallback)
  geradoEm     DateTime  @default(now())
  entregueEm   DateTime? // quando apareceu no chat; null = ainda não
  tokenPublico String?   @unique
}

/// Programa de indicação: quem convidou quem, e se o convite "valeu".
///
/// `indicadoId` é ÚNICO de propósito: cada pessoa entra por no máximo UMA
/// indicação, e é o banco que garante isso — não uma checagem de rota que uma
/// segunda aba consegue furar. Autoindicação é barrada em lib/indicacao.ts.
///
/// O vínculo nasce "cadastrado" e só vira "ativado" quando o indicado termina
/// a primeira conversa (onboardingEm) — cadastro sozinho não paga ponto,
/// senão o programa premia criação de conta fantasma.
///
/// Os pontos dos dois lados usam refId = Indicacao.id, então apagar a conta
/// do indicado leva a linha embora (Cascade) mas NÃO desfaz os pontos já
/// pagos ao indicador — crédito é evento, não estado derivado.
model Indicacao {
  id          String    @id @default(cuid())
  indicadorId String
  indicador   User      @relation("indicador", fields: [indicadorId], references: [id], onDelete: Cascade)
  indicadoId  String    @unique
  indicado    User      @relation("indicado", fields: [indicadoId], references: [id], onDelete: Cascade)
  status      String    @default("cadastrado") // "cadastrado" | "ativado"
  criadoEm    DateTime  @default(now())
  ativadoEm   DateTime?

  @@index([indicadorId])
}

/// Memória do assistente: o que ele aprendeu sobre a pessoa e deve lembrar
/// nas próximas conversas.
///
/// São registros DISCRETOS, não um arquivo único de texto. A diferença importa:
/// registro solto pode ser lido, apagado e podado um a um; um blob cresce sem
/// limite e não dá para esquecer só uma coisa.
///
/// `conteudo` é CIFRADO (AES-256-GCM, lib/cripto.ts) — passe sempre por
/// lib/memoria-repo.ts, nunca por db.memoriaUsuario direto. É o mesmo motivo
/// de Transacao: ler direto devolve "v1.…" e ninguém percebe.
model MemoriaUsuario {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo     String // "situacao" | "plano" | "preferencia" | "compromisso"
  conteudo String // CIFRADO
  origem   String   @default("ia") // "ia" (aprendeu na conversa) | "usuario" (escreveu à mão)
  criadoEm DateTime @default(now())

  @@index([userId, criadoEm])
}

// Lista de espera da landing (produto em desenvolvimento)
model Waitlist {
  id       String   @id @default(cuid())
  email    String   @unique
  criadoEm DateTime @default(now())
}

/// Lead B2B da página /empresas. Sem userId de propósito: quem preenche é
/// contato comercial, não usuário do app. E-mail único com upsert — mandar
/// duas vezes atualiza o pedido em vez de duplicar a fila.
model LeadEmpresa {
  id       String   @id @default(cuid())
  empresa  String
  nome     String
  email    String   @unique
  tamanho  String? // faixa de funcionários: "1-10" | "11-50" | "51-200" | "200+"
  mensagem String?
  criadoEm DateTime @default(now())

  @@index([criadoEm])
}

model ContaFixa {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome          String // cifrado (AES-256-GCM) — ver lib/cripto.ts
  valor         String // cifrado; era Decimal, virou texto porque cifra não é número
  diaVencimento Int?
  ativa         Boolean  @default(true)
  criadoEm      DateTime @default(now())
}

model Categoria {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome       String
  tipo       String // "receita" | "despesa"
  cor        String?
  padrao     Boolean     @default(false) // veio pré-populada por perfil, ou criada pelo usuário
  escopo     String      @default("pessoal") // "pessoal" | "trabalho" (Módulo Avançado)
  transacoes Transacao[]
  orcamentos Orcamento[]
}

/// Teto de gasto mensal, por categoria ou para o mês inteiro.
///
/// É um teto PERMANENTE, não um por mês. É assim que a pessoa pensa ("meu
/// limite de delivery é R$400"), e um registro por mês significaria alguém ter
/// de recriar doze orçamentos por ano para que nada mude.
///
/// `limite` é CIFRADO — é valor financeiro, mesma regra de Transacao. Passe
/// sempre por lib/orcamento-repo.ts.
model Orcamento {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// null = teto do mês inteiro, somando todas as saídas
  categoriaId  String?
  categoria    Categoria? @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  limite       String // CIFRADO
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt

  @@index([userId])
}

model Transacao {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  descricao   String // cifrado (AES-256-GCM) — ver lib/cripto.ts
  valor       String // cifrado; era Decimal, virou texto porque cifra não é número
  // tipo, data e categoriaId ficam em claro de propósito: o banco filtra e
  // ordena por eles. Sozinhos revelam a FORMA do histórico (quantos lançamentos,
  // quando, quantos de entrada), nunca quanto nem do quê.
  tipo        String // "receita" | "despesa"
  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  data        DateTime
  criadoEm    DateTime   @default(now())

  // Nada entra no dash sem ação explícita do usuário.
  //
  // O default virou FALSE (SPEC v3 §3). Antes era true, e o argumento na época
  // era proteger as linhas já existentes — mas default só vale para linha NOVA,
  // então as antigas nunca estiveram em risco. O que o default true fazia de
  // verdade era transformar qualquer caminho de escrita novo que esquecesse o
  // campo num caminho que conta dinheiro no dash sem ninguém ter confirmado.
  //
  // Agora esquecer produz linha PENDENTE, que é visível e inofensiva. Os
  // caminhos que já têm confirmação da pessoa (lançamento manual, card do chat,
  // linha de ajuste) passam `confirmado: true` explicitamente.
  confirmado      Boolean        @default(false)
  origem          String         @default("manual") // "manual" | "extrato"
  // Separação pessoal × trabalho (Módulo Avançado, MEI/autônomo). Em claro
  // como tipo e data: o banco filtra por ele e ele sozinho não revela valor.
  escopo          String         @default("pessoal") // "pessoal" | "trabalho"
  extratoImportId String?
  extratoImport   ExtratoImport? @relation(fields: [extratoImportId], references: [id], onDelete: SetNull)

  @@index([userId, confirmado])
}

/// Metadados do processamento de um extrato. NÃO guarda o arquivo nem o texto
/// do extrato — só o que é preciso para auditar o import e o custo da chamada.
model ExtratoImport {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String // "processando" | "aguardando_confirmacao" | "confirmado" | "falhou"
  banco         String? // detectado pelo modelo, ex: "nubank"
  periodoInicio DateTime?
  periodoFim    DateTime?
  totalLinhas   Int?
  erroValidacao String? // preenchido quando a validação aritmética falha
  tokensEntrada Int?
  tokensSaida   Int?
  modelo        String? // qual modelo processou — o preço muda com ele
  criadoEm      DateTime  @default(now())

  transacoes Transacao[]

  @@index([userId, criadoEm])
}

/// Uma conversa do chat. O histórico que a pessoa pode reabrir.
///
/// `titulo` é CIFRADO como as mensagens: ele sai da primeira frase que a pessoa
/// escreveu, e "como eu pago o cartão da minha mãe" é tão sensível quanto o
/// resto da conversa.
model Conversa {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo       String? // CIFRADO
  criadoEm     DateTime           @default(now())
  atualizadoEm DateTime           @updatedAt
  mensagens    ConversaMensagem[]

  @@index([userId, atualizadoEm])
}

/// Mensagem de uma conversa.
///
/// `texto` é CIFRADO, e aqui isso é ainda menos negociável que em Transacao: a
/// conversa junta número, contexto de vida e o que a pessoa contou sobre a
/// família dela no mesmo lugar.
///
/// `cards` guarda SÓ os cards informativos (resumo, gráfico, recomendação,
/// lembrete, caminho). Proposta de ação — lançamento, orçamento, extrato — não
/// volta: ela é de uma vez só, e reabrir a conversa com um botão "Confirmar"
/// vivo convidaria a registrar duas vezes o mesmo gasto.
model ConversaMensagem {
  id         String   @id @default(cuid())
  conversaId String
  conversa   Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  papel      String // "usuario" | "ia"
  texto      String // CIFRADO
  cards      Json?
  criadoEm   DateTime @default(now())

  @@index([conversaId, criadoEm])
}

/// Respostas do onboarding de 3 passos (SPEC v3 §2.4–2.6).
///
/// NÃO substitui `Perfil`, ao contrário do que a spec supõe: a spec fala em
/// remover `Diagnostico`, que nunca existiu neste banco. `Perfil` guarda a
/// trilha (lancador/guardador/impulsivo/sonhador) e é lido pela Trilha hoje —
/// apagá-lo esvaziaria a trilha de todo mundo. Os dois convivem: `Perfil` diz
/// QUAL trilha, `Onboarding` diz O QUE a pessoa respondeu e por quê.
model Onboarding {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  objetivo      String // ver §2.4
  objetivoOutro String?
  eixo2         String // "dificuldade" | "motivacao"
  eixo2Valor    String
  eixo2Outro    String?
  momento       String // "extrato" | "chat" | "depois"
  nivelInferido String? // saída do processamento, não pergunta
  situacoes     String[] // inferidas
  concluidoEm   DateTime?
  criadoEm      DateTime  @default(now())
}

/// Cada crédito de ponto, com o que o originou.
///
/// A chave única (userId, motivo, refId) é o que impede farmar: concluir o
/// mesmo módulo duas vezes tenta gravar a mesma linha e o banco recusa.
///
/// `refId` NÃO pode ser nulo, e isso não é preciosismo. No Postgres, dois NULL
/// não colidem num índice único: com refId nulo a chave deixa de garantir
/// qualquer coisa, em silêncio. Testado contra o banco antes de mudar — duas
/// linhas idênticas entraram sem erro. E o motivo mais exposto é justamente um
/// sem referência natural ("onboarding"), que rodaria a cada refazer.
/// Quem não tem referência escreve o sentinela SEM_REF (lib/pontos.ts).
model EventoPontuacao {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  motivo   String // "onboarding"|"modulo_concluido"|"quiz_acerto"|"lancamento_confirmado"|"streak_semana"
  pontos   Int
  refId    String   @default("-") // id do módulo/lançamento que gerou, ou "-"
  criadoEm DateTime @default(now())

  @@unique([userId, motivo, refId])
  @@index([userId, criadoEm])
}

/// As três linhas de texto que a IA escreve lendo o dash (§2.10).
model Insight {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  texto    String   @db.Text
  tipo     String // "gasto"|"divida"|"progresso"|"alerta"
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  @@index([userId, criadoEm])
}

/// Módulo recomendado pela IA, com o porquê — que o card exibe.
///
/// A recomendação PRECISA ficar gravada, não recalculada a cada chamada. O
/// gatilho da §2.7 dispara ao concluir X% da trilha recomendada, e uma trilha
/// que se recalcula muda de tamanho conforme os números da pessoa mudam: a
/// porcentagem perseguiria um alvo móvel e ninguém nunca terminaria.
///
/// `entregueEm` é o que faz a leva nova chegar no chat UMA vez. Sem ele a
/// mensagem reapareceria a cada abertura, porque a condição que a gerou
/// continua verdadeira.
model RecomendacaoTrilha {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduloId   String
  modulo     Modulo    @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  motivo     String    @db.Text
  origem     String // "onboarding"|"gatilho_percentual"|"lacuna_chat"
  ordem      Int
  entregueEm DateTime?
  criadoEm   DateTime  @default(now())

  /// A leva é uma UNIDADE, não um acúmulo.
  ///
  /// São 4 aulas que ficam à vista até a última ser concluída; só então a leva
  /// fecha e outra de 4 entra. Sem este número, as recomendações se empilhavam
  /// para sempre — uma conta chegou a 12 — e "Recomendados" virava um arquivo
  /// morto em vez de responder "o que eu faço agora".
  leva          Int       @default(1)
  /// Trocada pelo chat: saiu da leva ativa, mas a linha fica para o histórico
  /// mostrar que aquela aula chegou a ser recomendada e por quê.
  substituidaEm DateTime?

  @@unique([userId, moduloId, origem])
}

model Perfil {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      String
  respostas Json
  criadoEm  DateTime @default(now())
}

model Modulo {
  id               String   @id @default(cuid())
  slug             String   @unique
  titulo           String
  subtitulo        String
  tipoPerfil       String
  ordem            Int
  /// Quanto o módulo vale ao ser concluído. 30 iniciante · 40 intermediário ·
  /// 50 avançado, na régua da trilha escolar.
  ///
  /// Chamava-se `xp` e era coluna MORTA: os seeds gravavam 50 em todos e
  /// nenhum arquivo de lib/, app/ ou components/ lia. O crédito real sempre
  /// veio de PONTOS_POR_MOTIVO. Renomear em vez de acrescentar `pontos` evita
  /// duas colunas para a mesma ideia — mas note que o valor daqui AINDA não é
  /// o que se credita; ligar os dois muda a economia de pontos e é decisão à
  /// parte (ver docs/backlog-produto.md).
  pontos           Int      @default(50)
  // --- SPEC v3 §3 ---
  thumbnail        String?
  duracaoMin       Int      @default(2)
  tags             String[] // alimenta a busca da Trilha
  // --- trilha escolar (07/08/2026): bloco, pré-requisito e pontuação ---
  /// Unidade temática dentro da trilha do segmento. 33 blocos ao todo; o
  /// rótulo viaja junto porque é texto editorial ("Bloco A · Circulação social
  /// do dinheiro"), e uma tabela `Bloco` só para guardar um par id/rótulo
  /// obrigaria um join em toda leitura da trilha para não ganhar nada.
  blocoId          String?
  blocoRotulo      String?
  /// O módulo que precisa estar concluído para este abrir, por SLUG.
  ///
  /// Slug e não id porque o grafo vem escrito na fonte (102 arestas, 5 raízes)
  /// e o slug é o que existe lá — resolver para id no seed criaria uma ordem
  /// de inserção obrigatória, e um upsert fora de ordem gravaria null em
  /// silêncio. Com slug, semear em qualquer ordem dá o mesmo grafo.
  preRequisitoSlug String?
  /// Quiz sem consulta: muda o rótulo da tela e a expectativa de quem responde.
  ehRevisao        Boolean  @default(false)

  /// NÍVEL e SITUAÇÃO decidem a ORDEM do corredor, não mais o acesso livre.
  ///
  /// Até 05/08/2026 a trilha era biblioteca posicionada: estes dois campos
  /// achavam a aula certa e NADA travava nada. Com o corredor (decisão da
  /// fundadora, ver lib/corredor.ts) eles continuam sendo o que posiciona a
  /// pessoa — só que agora posicionam a FILA: é por eles que a IA monta a
  /// sequência de módulos, e a sequência é o que abre um de cada vez.
  ///
  /// `situacoes` VAZIO não é falta de classificação: é "serve pra todo mundo".
  /// O vocabulário é todo de déficit (dívida, sem reserva, renda que varia), e
  /// as aulas de quem JÁ guarda bem não casam com nenhum deles — se situação
  /// fosse o único eixo, elas ficariam inalcançáveis.
  nivel           String               @default("iniciante") // iniciante|intermediario|avancado
  situacoes       String[]
  /// Para QUEM esta aula é. Separa a trilha adulta (o produto no ar) da trilha
  /// de Ensino Médio, que cobre a matriz do Banco Central e fala com 15–17 anos.
  ///
  /// O default é "adulto" e isso não é detalhe: as aulas já gravadas não têm o
  /// campo, e sem default elas nasceriam com string vazia e sumiriam da
  /// biblioteca de todo mundo no mesmo deploy.
  ///
  /// NUNCA leia Modulo sem filtrar por aqui — use `filtroDeModulo()`
  /// (lib/publico.ts). Um findMany sem o filtro devolve as duas trilhas
  /// misturadas, e o sintoma é a IA recomendando "Estudar sem se afundar" para
  /// alguém de 38 anos. `scripts/testar-publico.mts` quebra quando isso escapa.
  publico         String               @default("adulto") // "adulto" | "em"
  telas           Tela[]
  progresso       ProgressoModulo[]
  progressoLicoes ProgressoLicao[]
  recomendacoes   RecomendacaoTrilha[]

  @@index([tipoPerfil, ordem])
  @@index([publico, ordem])
}

model Tela {
  id       String @id @default(cuid())
  moduloId String
  modulo   Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  ordem    Int
  tipo     String
  label    String
  conteudo Json

  /// O que dizer a quem está acompanhando a criança.
  ///
  /// "Mostre uma moeda e uma cédula de verdade enquanto lê o texto." Vem em
  /// todas as 535 telas da trilha escolar e é a parte pedagógica do material:
  /// sem ela o conteúdo vira só texto na tela.
  ///
  /// É COLUNA, e não mais uma chave dentro de `conteudo`, porque é universal —
  /// os cinco tipos de tela têm formatos de conteúdo diferentes e este campo
  /// não pertence a nenhum deles em particular.
  ///
  /// A criança pode estar sozinha ou acompanhada (decisão da fundadora,
  /// 07/08/2026), então o player NÃO mostra por padrão nem esconde de vez:
  /// fica a um toque, para quem estiver junto. Obrigar a passar por ela
  /// atrapalharia quem está só; omitir tiraria o material de quem medeia.
  mediacao String?

  /// A qual lição esta tela pertence NÃO é coluna, e isso é decisão, não falta.
  ///
  /// O agrupamento sai do TIPO da tela, calculado em lib/licoes.ts, porque uma
  /// coluna só guardaria UM valor e a tela de quiz precisa aparecer em DUAS
  /// lições: na "Novo conceito!", com o conceito ainda na tela (com consulta),
  /// e na "Revisão!", sozinha (sem consulta). Gravar o vínculo obrigaria a
  /// duplicar a pergunta no banco, e aí duas cópias da mesma questão passariam
  /// a divergir na primeira correção de texto.
  @@unique([moduloId, ordem])
}

/// O módulo como um todo. Com o corredor (05/08/2026) ele passou a ser o
/// AGREGADO das lições: `concluido` vira true quando todas as lições do módulo
/// fecham, e é ele que o corredor consulta para liberar o módulo seguinte.
///
/// `telaAtual` ficou como resíduo do player antigo, que percorria as telas do
/// módulo em fila única. Quem retoma de onde parou agora lê
/// ProgressoLicao.telaAtual — a coluna fica porque as linhas antigas têm dado
/// nela e apagar não devolve nada.
model ProgressoModulo {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduloId    String
  modulo      Modulo    @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  concluido   Boolean   @default(false)
  telaAtual   Int       @default(0)
  concluidoEm DateTime?
  criadoEm    DateTime  @default(now())

  @@unique([userId, moduloId])
}

/// Progresso de UMA lição de um módulo.
///
/// Existe porque com os 4 tipos de lição (Novo conceito, História, Revisão,
/// Aplicação) o módulo deixou de ser a unidade que se conclui: cada lição tem
/// o seu fim, o seu XP e a sua tela de fechamento, e a lição seguinte só abre
/// quando a anterior fecha.
///
/// `acertos`/`totalQuiz` ficam aqui, e não são recalculáveis depois: a tela de
/// fim mostra "4 de 5" e o XP creditado foi proporcional a ISSO. Guardar o
/// resultado é o que permite reabrir a tela de fim sem recreditar nada.
model ProgressoLicao {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduloId    String
  modulo      Modulo    @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  /// 1..4 — ver TIPOS_LICAO em lib/licoes.ts
  licao       Int
  concluido   Boolean   @default(false)
  telaAtual   Int       @default(0)
  acertos     Int       @default(0)
  totalQuiz   Int       @default(0)
  /// Segundos gastos na lição, somados entre as visitas. Alimenta a tela de fim.
  segundos    Int       @default(0)
  concluidoEm DateTime?
  criadoEm    DateTime  @default(now())

  @@unique([userId, moduloId, licao])
  @@index([userId, moduloId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Dado macro que os módulos citam, versionado fora do texto.
///
/// O conteúdo da aula NUNCA crava o número: escreve `{{selic_atual}}` e a
/// variável é preenchida na hora de exibir. Selic e IPCA mudam várias vezes
/// por ano, e um número no corpo do texto vira mentira silenciosa meses depois
/// — o mesmo motivo da tabela de preços em lib/custo.ts.
///
/// `fonte` e `apuradoEm` não são enfeite: um número macro sem data e sem quem
/// apurou não dá para conferir nem para saber se envelheceu.
model Indicador {
  chave        String   @id // "selic_atual", "ipca_12m", "rotativo_medio"
  valor        String // texto: alguns são percentual, outros moeda, outros regra
  rotulo       String // como aparece no texto: "14,25% ao ano"
  numero       Float? // quando dá para calcular com ele
  fonte        String // "Copom/Banco Central"
  apuradoEm    DateTime
  atualizadoEm DateTime @updatedAt
}
